{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "Jwt": {
      "Key": "SuperSecretSuperLongKeyThatIsAtLeast32BytesLongForSecurityReasons!!",
      "Issuer": "ApiAggregator",
      "Audience": "ApiAggregatorUsers",
      "ExpirationInMinutes": 60
    },
    "Apis": {
      "Weather": {
        "BaseUrl": "https://api.open-meteo.com/v1/",
        "Endpoint": "forecast?latitude=52.52&longitude=13.41&current=temperature_2m,wind_speed_10m",
        "TimeoutSeconds": 5,
        "CacheDurationSeconds": 60
      },
      "News": {
        "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
        "Endpoint": "topstories.json",
        "TimeoutSeconds": 5,
        "CacheDurationSeconds": 120
      },
      "GitHub": {
        "BaseUrl": "https://api.github.com/",
        "Endpoint": "users/octocat",
        "TimeoutSeconds": 5,
        "CacheDurationSeconds": 180
      }
    },
    "Resilience": {
      "RetryCount": 3,
      "BackoffBaseSeconds": 2,
      "BreakDurationSeconds": 15,
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 10
    }
  }
}
